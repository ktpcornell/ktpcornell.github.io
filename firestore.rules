rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Members and FAQ are public — read by anyone (public site)
    match /members/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faq/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users can read their own document; only admins can write
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // Any authenticated user can read announcements; only admins can write
    match /announcements/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Any authenticated user can read alumni; only admins can write
    match /alumni/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Helper function: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
