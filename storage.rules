rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public images readable by anyone
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
